# Шаблон настроек. Скопируй в файл .env рядом и заполни (он в git не попадает).
TELEGRAM_BOT_TOKEN=
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# твой Telegram user id (узнать: написать @userinfobot)
OWNER_ID=
# id группы обсуждения канала, начинается с -100
DISCUSSION_CHAT_ID=
# true — отвечать без одобрения. Включать только при точности >= 90% (команда /stats)
AUTO_REPLY=false
# пометка под каждым ответом (закон РК об ИИ: маркировка синтетического контента); пусто — без пометки
AI_LABEL=ИИ-помощник
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low
DB_PATH=data/assistant.db
